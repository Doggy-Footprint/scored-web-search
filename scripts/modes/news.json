{
  "_readme": "For news coverage. Peer-review off, recency dominant (fast 'news' half-life, tight fresh windows), engagement on. Own tier ladder: 1 = the instrument itself (gazette/court/regulator, already in the base table), 2 = original reporting (wires, papers of record), 3 = re-report and analysis (base raised 60->66 so it lands in SUPPORT), 4 = general and trade media. Primary-vs-re-report is expressed only as this tier convention. An outlet's every host must be listed, or the same story scores differently by host.",

  "signals": { "peer_review": false },

  "defaults": { "field": "news" },

  "field_halflife_years": { "news": 0.2 },

  "tiers": {
    "3": {
      "base": 66,
      "label": "Re-report and analysis: law-firm client alerts, policy think tanks, professional associations, trackers"
    }
  },

  "recency": {
    "fresh_bonuses": [
      { "max_age_years": 0.02, "points": 4.0 },
      { "max_age_years": 0.14, "points": 2.0 }
    ],
    "decay": { "grace_years": 0.01, "max_penalty": -12.0 },
    "classic_exemption_citations": 1000,
    "classic_softening": { "citations": 300, "factor": 0.4 }
  },

  "engagement": {
    "hackernews": { "coefficient": 4.5, "cap": 14.0, "min_tier": 1 }
  },

